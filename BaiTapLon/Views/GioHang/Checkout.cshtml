@model IEnumerable<BaiTapLon.Models.GioHang>
<main role="main">
    <!-- Block content - Đục lỗ trên giao diện bố cục chung, đặt tên là `content` -->
    <div class="container mt-4">

            <input type="hidden" name="NguoiDungID" id="NguoiDungID" value="@ViewBag.IDNguoiDung">

            <div class="py-5 text-center">
                <i class="fa fa-credit-card fa-4x" aria-hidden="true"></i>
                <h2>Thanh toán</h2>
                <p class="lead">Vui lòng kiểm tra thông tin Khách hàng, thông tin Giỏ hàng trước khi Đặt hàng.</p>
            </div>

            <div class="row">
                <div class="col-md-4 order-md-2 mb-4">
                    <h4 class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Giỏ hàng</span>
                        <span class="badge badge-secondary badge-pill">2</span>
                    </h4>
                    <ul class="list-group mb-3">

                        @foreach(var item in Model)
                        {
                        <li class="list-group-item d-flex justify-content-between lh-condensed">
                            <div>
                                <h6 class="my-0">@item.Pet.TenPet</h6>
                                <small class="text-muted">@item.Pet.Gia * 1</small>
                            </div>
                                <span class="text-muted">@item.Pet.Gia VND</span>
                        </li>
                        }
                    </ul>

                </div>
                <div class="col-md-8 order-md-1">
                    <h4 class="mb-3">Thông tin khách hàng</h4>

                    <div class="row">
                        <div class="col-md-12">
                            <label for="kh_ten">Họ tên</label>
                            <input type="text" class="form-control" name="TenKhachHang" id="TenKhachHang"
                                   placeholder="Tên khách hàng" required>
                        </div>
                        <div class="col-md-12">
                            <label for="kh_diachi">Địa chỉ</label>
                            <input type="text" class="form-control" name="DiaChi" id="DiaChi"
                                   placeholder="Địa chỉ" required>
                        </div>
                        <div class="col-md-12">
                            <label for="kh_dienthoai">Điện thoại</label>
                            <input type="text" class="form-control" name="SoDienThoai" id="SoDienThoai"
                                   placeholder="Số điện thoại" required>
                        </div>
               
                    </div>
                    
                    <hr class="mb-4">
                    <button class="checkout btn btn-primary btn-lg btn-block" type="submit" name="btnDatHang">
                        Đặt
                        hàng
                    </button>
                </div>
            </div>


    </div>
    <!-- End block content -->
</main>

@section Scripts{
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@10"></script>
    <script>
        $(document).ready(function () {
            $(".checkout").click(function () {
            var TenKhachHang = $("#TenKhachHang").val();
            var NguoidungId = $("#NguoiDungID").val();
            var DiaChi = $("#DiaChi").val();
            var SoDienThoai = $("#SoDienThoai").val();
                $.ajax({
                    url: "/GioHang/CheckoutCheck",
                    data: {
                    "TenKhachHang": TenKhachHang,
                        "NguoiDungID": NguoidungId,
                        "DiaChi": DiaChi,
                        "SoDienThoai": SoDienThoai,
                        type: "ajax"
                    },
                    success: function (data) {
                        console.log(data);
                        Swal.fire({
                            icon: 'success',
                            title: 'Bạn đã đặt hàng thành công!!',
                            showConfirmButton: false,
                            timer: 1500
                        })
                    },
                    error: function (data) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: 'Vui lòng thử lại!!',
                        })
                    }
                })
            })
        })
    </script>
}